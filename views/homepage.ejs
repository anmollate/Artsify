<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/favicon.ico">
    <title>Artistry | <%=title%></title>
    <link rel="stylesheet" href="styleshome.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playwrite+VN:wght@100..400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="menubar">
        <img class="logo" src="images/Logo.png" alt="Website Logo"> <!-- Added alt text -->
        <nav class="list">
            <ol class="olist1">
                <li><a class="HOME" href="/homepage">HOME</a></li>
                <li>SHOP</li>
                <li>CATEGORIES</li>
                <li><a class="HOME" href="/about">ABOUT&nbsp;US</a></li>
                <li><a class="HOME" href="/contact">CONTACT</a></li>
            </ol>
        </nav>

        <div class="icons">
            <ol class="olist2">
                <li><input class="search" type="text" placeholder="Search"></li>
                <li><img class="cart" src="images/shopping-cart.webp" alt="Shopping Cart"></li> <!-- Added alt text -->
                <div class="dropdown-container">
                <li><img class="list" src="images/list.webp" alt="List Icon">
                    <div class="dropdown">
                        <ul>
                            <li>Your Profile</li>
                            <li>Your Orders</li>
                            <li>Posts</li>
                            <li>Settings</li>
                        </ul>
                    </div>
                    </div>
                </li> <!-- Added alt text -->
            </ol>
        </div>
    </div>
</body>
</html>
