<style>
    .menubar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 20px;
        background-color: #fff;
    }

    .logo {
        width: 70px;
        height: 20px;
    }

    /* Common styling for lists */
    .list, .dropdown ul {
        display: flex;
        list-style-type: none;
        gap: 40px;
        font-size: 15px;
        font-weight: 500;
        margin: 0;
        padding: 0;
        align-items: center;
    }

    /* Hover Effects for Links */
    .HOME {
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .HOME:hover {
        color: #007BFF;
    }

    /* Dropdown Menu Styling */
    .dropdown-container {
        position: relative;
    }

    .dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: white;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        min-width: 150px;
        border-radius: 5px;
        z-index: 10;
    }

    /* Inherit styles from .list */
    .dropdown ul {
        flex-direction: column; /* Display as a vertical list */
        background-color: white;
        border-radius: 5px;
        padding: 10px;
    }

    .dropdown ul li {
        padding: 10px;
        text-align: left;
        white-space: nowrap;
        transition: background 0.3s ease;
    }

    .dropdown ul li:hover {
        background-color: #f0f0f0;
    }

    /* Show dropdown on hover */
    .dropdown-container:hover .dropdown {
        display: block;
    }

    /* Icons Styling */
    .cart,
    .list img {
        width: 20px;
        cursor: pointer;
    }

    .cart:hover {
        opacity: 0.7;
    }

    /* Search Bar Styling */
    .search {
        width: 150px;
        height: 25px;
        text-align: center;
        border: none;
        border-radius: 10px;
        font-family: Arial, Helvetica, sans-serif;
        font-weight: bold;
    }

    /* Icons Section Styling */
    .icons {
        display: flex;
        gap: 20px;
        align-items: center;
    }
</style>

<div class="menubar">
    <img class="logo" src="images/Logo.png" alt="Website Logo">
    <nav class="list">
        <ol class="olist1">
            <li><a class="HOME" href="/homepage">HOME</a></li>
            <li><a class="HOME" href="/shop">SHOP</a></li>

            <!-- Dropdown for Categories -->
            <li class="dropdown-container">
                <a class="HOME">CATEGORIES</a>
                <div class="dropdown">
                    <ul>
                        <li><a href="/categories?category=portrait">Portrait</a></li>
                        <li><a href="/categories?category=wildlife">Wildlife</a></li>
                        <li><a href="/categories?category=landscape">Landscapes</a></li>
                        <li><a href="/categories?category=botanical">Botanical</a></li>
                        <li><a href="/categories?category=mandala art">Mandala Art</a></li>
                        <li><a href="/categories?category=madhubani art">Madhubani Art</a></li>
                        <li><a href="/categories?category=handicraft">Handicrafts</a></li>
                    </ul>
                </div>
            </li>
            

            <li><a class="HOME" href="/about">ABOUT&nbsp;US</a></li>
            <li><a class="HOME" href="/contact">CONTACT</a></li>
        </ol>
    </nav>

    <div class="icons">
        <ol class="olist2">
            <li><input class="search" type="text" placeholder="Search"></li>
            <li>
                <a href="/cart">
                    <img class="cart" src="images/shopping-cart.webp" alt="Shopping Cart">
                </a>
            </li>

            <!-- Profile Dropdown -->
            <li class="dropdown-container">
                <img class="list" src="images/list.webp" alt="List Icon">
                <div class="dropdown">
                    <ul>
                        <li><a class="HOME" href="#">Your Profile</a></li>
                        <li><a class="HOME" href="#">Your Orders</a></li>
                        <li><a class="HOME" href="#">Posts</a></li>
                        <li><a class="HOME" href="#">Settings</a></li>
                        <li><a class="HOME" href="#">My Shop</a></li>
                    </ul>
                </div>
            </li>
        </ol>
    </div>
</div>

