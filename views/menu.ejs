<style>
    .menubar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: #fff;
}

.logo {
    width: 70px;
    height: 20px;
}

ol {
    display: flex;
    list-style-type: none;
    gap: 40px;
    font-size: 15px;
    font-weight: 500;
    margin: 0;
}

/* Hover Effects for Links */
.HOME {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: color 0.3s ease;
}

/* Hover effect on link */
.HOME:hover {
    color: #007BFF; /* Change the color on hover */
}

/* Icons Styling */
.cart,
.list {
    width: 20px;
    cursor: pointer;
}

/* Icon hover effect */
.cart:hover {
    opacity: 0.7;
}

/* Search Bar Styling */
.search {
    width: 150px;
    height: 25px;
    text-align: center;
    border: none;
    border-radius: 10px;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: bold;
}

/* Icons Section Styling */
.icons {
    display: flex;
    gap: 20px;
    align-items: center;
}
</style>

<div class="menubar">
    <img class="logo" src="images/Logo.png" alt="Website Logo"> <!-- Added alt text -->
    <nav class="list">
        <ol class="olist1">
            <li><a class="HOME" href="/homepage">HOME</a></li>
            <li><a class="HOME" href="/shop">SHOP</a></li>
            <li><a class="HOME">CATEGORIES</a></li>
            <li><a class="HOME" href="/about">ABOUT&nbsp;US</a></li>
            <li><a class="HOME" href="/contact">CONTACT</a></li>
        </ol>
    </nav>

    <div class="icons">
        <ol class="olist2">
            <li><input class="search" type="text" placeholder="Search"></li>
            <li>
                <a href="/cart">
                    <img class="cart" src="images/shopping-cart.webp" alt="Shopping Cart">
                </a>
            </li>
             <!-- Added alt text -->
            <div class="dropdown-container">
            <li><img class="list" src="images/list.webp" alt="List Icon">
                <div class="dropdown">
                    <ul>
                        <li>Your Profile</li>
                        <li>Your Orders</li>
                        <li>Posts</li>
                        <li>Settings</li>
                        <li>My Shop</li>
                    </ul>
                </div>
                </div>
            </li> <!-- Added alt text -->
        </ol>
    </div>
</div>
