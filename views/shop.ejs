<script>
    document.addEventListener("DOMContentLoaded", function () {
    // Load existing cart from localStorage or initialize an empty array
    const cart = JSON.parse(localStorage.getItem("cart")) || [];

    // Select all "Add to Cart" buttons
    document.querySelectorAll(".addcart").forEach(button => {
        button.addEventListener("click", function () {
            const name = this.dataset.name;  // Get item name from data attribute
            const price = this.dataset.price; // Get item price

            // Create an item object
            const item = { name, price };

            // Add item to cart array
            cart.push(item);

            // Save updated cart to localStorage
            localStorage.setItem("cart", JSON.stringify(cart));

            // Alert user that item was added
            alert(`${name} added to cart!`);
        });
    });
});


</script>


